rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidStudent(data) {
      return data.name is string && data.studentId is string;
    }

    function isValidApplication(data) {
      return data.studentName is string && data.guardianPhone is string;
    }

    // Public read collections (for students, parents and public visitors)
    match /schoolInfo/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    match /results/{resultId} {
      allow read: if true;
      allow write: if true;
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if true;
    }

    // Online admission applications: parents can submit (create), read their app
    match /applications/{appId} {
      allow read, write: if true;
    }

    // Student accounts portal
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Settings & meta
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
